library(tidyverse)
library(tidymodels)
library(plotly) #for scatterplot matrix graphs
library(GGally) #for scatterplot matrix graphs
library(leaps) #for forward and backward stepwise regression
library(glmnet) #for LASSO and ridge regression
bears <- read_csv("C:\\Users\\grace\\OneDrive - The Pennsylvania State University\\STAT380\\In Class\\Data Sets\\bears.csv")
head(bears)
bears<- bears|>
filter(ObsNo==1)|>
select(-ID, -Name,-ObsNo)
dim(bears)
head(bears)
bears|>
summarise(across(everything(), ~ sum(is.na(.x))))
bears<-bears|>
select(-Age)
forwardBears<-bears|>
regsubsets(Weight~., data=_, method="forward")
summary(forwardBears)
plot(forwardBears,scale="adjr2")
bestForwardbears<-bears|>
lm(Weight~Neck_girth+Chest_girth,data=_)
summary(bestForwardbears)
plot(bestForwardbears, which=1)
plot(bestForwardbears, which=2)
backwardBears=bears|>
regsubsets(Weight~., data=_, method="backward")
summary(backwardBears)
plot(backwardBears,scale="adjr2")
set.seed(123)
bears_split <- initial_split(bears, prop = 0.80)
bears_train <- training(bears_split)
bears_test  <- testing(bears_split)
bears_folds <- vfold_cv(bears_train, v = 10)
bears_recipe <- recipe(Weight ~ ., data = bears_train)|>
step_normalize(all_numeric_predictors())|>
step_dummy(all_nominal_predictors())
#step_dummy(all_nominal_predictors()) |>
#step_normalize(all_numeric_predictors())
penalty_grid <- grid_regular(
penalty(range = c(-4, 2)),
levels = 50
)
# Ridge: mixture = 0
ridge_spec <- linear_reg(
penalty = tune(),
mixture = 0 #this is choosing ridge
) |>
set_engine("glmnet")
ridge_workflow <- workflow() |>
add_recipe(bears_recipe) |>
add_model(ridge_spec)
set.seed(123)
ridge_tuned <- tune_grid(
ridge_workflow,
resamples = bears_folds,
grid = penalty_grid,
metrics = metric_set(rmse, mse, mae)
)
autoplot(ridge_tuned)
ridge_best <- select_best(ridge_tuned, metric = "rmse")
ridge_best
ridge_final_workflow <- finalize_workflow(ridge_workflow, ridge_best)
ridge_fit <- fit(ridge_final_workflow, data = bears_train)
tidy(ridge_fit)
# Lasso: mixture = 1
lasso_spec <- linear_reg(
penalty = tune(),
mixture = 1 #this is choosing LASSO
) |>
set_engine("glmnet")
lasso_workflow <- workflow() |>
add_recipe(bears_recipe) |>
add_model(lasso_spec)
set.seed(123)
lasso_tuned <- tune_grid(
lasso_workflow,
resamples = bears_folds,
grid = penalty_grid,
metrics = metric_set(rmse, mse, mae)
)
autoplot(lasso_tuned)
lasso_best <- select_best(lasso_tuned, metric = "rmse")
lasso_best
lasso_final_workflow <- finalize_workflow(lasso_workflow, lasso_best)
lasso_fit <- fit(lasso_final_workflow, data = bears_train)
tidy(lasso_fit)
lasso_best
ridge_best
show_best(lasso_tuned, metric = "rmse", n = 5)
show_best(ridge_tuned, metric = "rmse", n = 5)
lasso_test_results <- predict(lasso_fit, bears_test) |>
bind_cols(bears_test |> select(Weight)) |>
metrics(truth = Weight, estimate = .pred)
ridge_test_results <- predict(ridge_fit, bears_test) |>
bind_cols(bears_test |> select(Weight)) |>
metrics(truth = Weight, estimate = .pred)
lasso_test_results
ridge_test_results
# Extract residuals and fitted values using augment()
ridge_train_results <- augment(ridge_fit, new_data = MLB_train)
