knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(tidymodels)
library(leaps)
library(glmnet)
library(rpart)
library(rpart.plot)
MLB <- read_csv("MLB.csv")
MLB2<- MLB|>
select(-PlayerName)|>
drop_na(Salary)
nrow(MLB2)
ncol(MLB2)
set.seed(321)
MLB_split <- initial_split(MLB2, prop = 0.85)
MLB_train <- training(MLB_split)
MLB_test  <- testing(MLB_split)
list(MLB_train, MLB_test) |>
map_int(nrow) #checking sizes could do separately and avoid list
backwardMLB=MLB2|>
regsubsets(Salary~., data=_, method="backward",nvmax = 19)
# NOTE: nvmax=19 means all 19 variables will be evaluated
summary(backwardMLB)
plot(backwardMLB,scale="adjr2")
# Create list of best predictor variables
predictors <- c("AtBat", "Hits", "Walks", "CRuns", "CRBI", "CWalks", "Division", "PutOuts")
#recipe
MLB_recipe<-
recipe(as.formula(paste("Salary ~", paste(predictors, collapse = " + "))),
data=MLB_train)
#setting engine
lm_model<-linear_reg() |>
set_engine("lm") # picks lm as our regression method
#workflow
MLB_wf <- workflow()|>
add_recipe(MLB_recipe)|>
add_model(lm_model)
MLB_mlr <- MLB_wf |>
fit(data = MLB_train)
MLB_mlr
tidy(MLB_mlr) #the usual coefficients and model
glance(MLB_mlr)
reg_metrics <- metric_set(mae, mse, rmse)
# Extract residuals and fitted values using augment()
train_results <- augment(MLB_mlr, new_data = MLB_train)
# Get Training metrics
train_metrics <- reg_metrics(
train_results,
truth = Salary,
estimate = .pred
)
train_metrics
# Extract residuals and fitted values using augment()
test_results  <- augment(MLB_mlr, new_data = MLB_test)
# Get Testing metrics
test_metrics <- reg_metrics(
test_results,
truth = Salary,
estimate = .pred
)
test_metrics
forwardMLB<-MLB2|>
regsubsets(Salary~., data=_, method="forward")
summary(forwardMLB)
plot(forwardMLB,scale="adjr2")
# Update recipe for Ridge and Lasso
MLB_recipe<-
recipe(Salary ~., data=MLB_train)|>
step_normalize(all_numeric_predictors())|>
step_dummy(all_nominal_predictors())
# Cross-validation is used to choose the penalty parameter.
MLB_folds <- vfold_cv(MLB_train, v = 10)
# Search penalties (lambda) from 10^-4 through 10^2.
penalty_grid <- grid_regular(
penalty(range = c(-4, 2)),
levels = 50
)
# Ridge: mixture = 0
ridge_spec <- linear_reg(
penalty = tune(),
mixture = 0 #this is choosing ridge
) |>
set_engine("glmnet")
ridge_workflow <- workflow() |>
add_recipe(MLB_recipe) |>
add_model(ridge_spec)
ridge_tuned <- tune_grid(
ridge_workflow,
resamples = MLB_folds,
grid = penalty_grid,
metrics = metric_set(rmse, mse, mae)
)
autoplot(ridge_tuned)
ridge_best <- select_best(ridge_tuned, metric = "rmse")
ridge_final_workflow <- finalize_workflow(ridge_workflow, ridge_best)
ridge_fit <- fit(ridge_final_workflow, data = MLB_train)
tidy(ridge_fit)
# Extract residuals and fitted values using augment()
ridge_train_results <- augment(ridge_fit, new_data = MLB_train)
# Get Training metrics
ridge_train_metrics <- reg_metrics(
ridge_train_results,
truth = Salary,
estimate = .pred
)
ridge_train_metrics
# Extract residuals and fitted values using augment()
ridge_test_results  <- augment(ridge_fit, new_data = MLB_test)
# Get Testing metrics
ridge_test_metrics <- reg_metrics(
ridge_test_results,
truth = Salary,
estimate = .pred
)
ridge_test_metrics
# Lasso: mixture = 1
lasso_spec <- linear_reg(
penalty = tune(),
mixture = 1 #this is choosing LASSO
) |>
set_engine("glmnet")
lasso_workflow <- workflow() |>
add_recipe(MLB_recipe) |>
add_model(lasso_spec)
lasso_tuned <- tune_grid(
lasso_workflow,
resamples = MLB_folds,
grid = penalty_grid,
metrics = metric_set(rmse, mse, mae)
)
autoplot(lasso_tuned)
lasso_best <- select_best(lasso_tuned, metric = "rmse")
lasso_final_workflow <- finalize_workflow(lasso_workflow, lasso_best)
lasso_fit <- fit(lasso_final_workflow, data = MLB_train)
tidy(lasso_fit)
# Extract residuals and fitted values using augment()
lasso_train_results <- augment(lasso_fit, new_data = MLB_train)
# Get Training metrics
lasso_train_metrics <- reg_metrics(
ridge_train_results,
truth = Salary,
estimate = .pred
)
lasso_train_metrics
# Extract residuals and fitted values using augment()
lasso_test_results  <- augment(lasso_fit, new_data = MLB_test)
# Get Testing metrics
lasso_test_metrics <- reg_metrics(
ridge_test_results,
truth = Salary,
estimate = .pred
)
lasso_test_metrics
# Update Recipe for Tree
MLB_recipe=recipe(Salary~., data=MLB_train)
tree_spec <- decision_tree() |>
set_mode("regression")|>
set_engine("rpart", model=TRUE)
# create Workflow
tree_workflow <- workflow() |>
add_recipe(MLB_recipe) |>
add_model(tree_spec)
MLB_tree=tree_workflow |>
fit(data = MLB_train)
tree_object=MLB_tree |>
extract_fit_engine()
rpart.plot(tree_object)
MLB_tree_predict <-
tree_workflow |>
fit(data = MLB_train)
tree_test_results <- augment(MLB_tree_predict, new_data = MLB_train) ## adding original data
tree_test_results|>
reg_metrics(truth = Salary, estimate = .pred)
MLB_tree_predict <-
tree_workflow |>
fit(data = MLB_test)
tree_test_results <- augment(MLB_tree_predict, new_data = MLB_test) ## adding original data
tree_test_results|>
reg_metrics(truth = Salary, estimate = .pred)
